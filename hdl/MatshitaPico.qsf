set_location_assignment PIN_74 -to cn9_db[7]
set_location_assignment PIN_12 -to cn9_c16m
set_location_assignment PIN_9 -to cn9_data
set_location_assignment PIN_8 -to cn9_dsck
set_location_assignment PIN_10 -to cn9_lrck
set_location_assignment PIN_15 -to cn9_empasis
set_location_assignment PIN_21 -to cn9_effk
set_location_assignment PIN_52 -to rp_d[0]
set_location_assignment PIN_51 -to rp_d[1]
set_location_assignment PIN_50 -to rp_d[2]
set_location_assignment PIN_49 -to rp_d[3]
set_location_assignment PIN_48 -to rp_d[4]
set_location_assignment PIN_46 -to rp_d[5]
set_location_assignment PIN_45 -to rp_d[6]
set_location_assignment PIN_44 -to rp_d[7]
set_location_assignment PIN_62 -to TCK
set_location_assignment PIN_14 -to TDI
set_location_assignment PIN_71 -to TDO
set_location_assignment PIN_23 -to TMS
set_location_assignment PIN_35 -to rp_frame_sync
set_location_assignment PIN_36 -to rp_lrck
set_location_assignment PIN_37 -to rp_bclk
set_location_assignment PIN_29 -to rp_empasis
set_location_assignment PIN_30 -to rp_subq
set_location_assignment PIN_31 -to rp_audio_data
set_location_assignment PIN_33 -to rp_stch_req
set_location_assignment PIN_34 -to rp_dat_avail
set_location_assignment PIN_54 -to rp_st_avail
set_location_assignment PIN_55 -to rp_byte_vld
set_location_assignment PIN_39 -to rp_chan
set_location_assignment PIN_57 -to rp_byte_req
set_location_assignment PIN_41 -to rp_cmd_stb
set_location_assignment PIN_17 -to cn9_scor
set_location_assignment PIN_16 -to cn9_sbcp
set_location_assignment PIN_18 -to cn9_scck
set_location_assignment PIN_79 -to cn9_drq
set_location_assignment PIN_77 -to cn9_dten
set_location_assignment PIN_4 -to cn9_enable
set_location_assignment PIN_73 -to cn9_n_cmd
set_location_assignment PIN_76 -to cn9_n_hrd
set_location_assignment PIN_80 -to cn9_n_hwr
set_location_assignment PIN_5 -to cn9_n_ihac
set_location_assignment PIN_6 -to cn9_n_stch
set_location_assignment PIN_75 -to cn9_n_sten
set_location_assignment PIN_11 -to cn9_n_xaen
set_location_assignment PIN_60 -to cn9_db_dir
