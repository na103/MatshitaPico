#
# TQFP100 variant. CPLD ATF1508AS-10AU100 (TQFP-100) SOLDERED on the PCB,
# ISP programming via the JTAG connector. Quartus fit on EPM7128STC100-10 (same
# die as the EPM7128SLC84-10 of the PLCC84 project in ../): the pin assignments
# are the 1:1 per-macrocell conversion from the ATF1508AS datasheet pinout tables
# (doc0784 p.21-23) -> logic, fit and timing IDENTICAL to the PLCC84 project.
# The Verilog sources are SHARED (../MatshitaPico_top.v etc.): any HDL change
# applies to both variants; re-fit BOTH projects. JED: output_files/POF2JED.bat
# (here with -JTAG on + TDI/TMS pull-ups for ISP). Do NOT touch the PLCC84
# project in ../ (rev.0/rev.1 stay on the socket).
#
# The header below is the standard Quartus/Altera tool boilerplate.
# =============================================================================
# -------------------------------------------------------------------------- #
#
# Copyright (C) 1991-2013 Altera Corporation
# Your use of Altera Corporation's design tools, logic functions
# and other software and tools, and its AMPP partner logic
# functions, and any output files from any of the foregoing
# (including device programming or simulation files), and any
# associated documentation or information are expressly subject
# to the terms and conditions of the Altera Program License
# Subscription Agreement, Altera MegaCore Function License
# Agreement, or other applicable license agreement, including,
# without limitation, that your use is for the sole purpose of
# programming logic devices manufactured by Altera and sold by
# Altera or its authorized distributors.  Please refer to the
# applicable agreement for further details.
#
# -------------------------------------------------------------------------- #
#
# Quartus II 64-Bit
# Version 13.0.1 Build 232 06/12/2013 Service Pack 1 SJ Web Edition
#
# -------------------------------------------------------------------------- #


set_global_assignment -name FAMILY MAX7000S
set_global_assignment -name DEVICE "EPM7128STC100-10"
set_global_assignment -name TOP_LEVEL_ENTITY MatshitaPico_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name LAST_QUARTUS_VERSION "13.0 SP1"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name DEVICE_FILTER_PACKAGE TQFP
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 100
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR "-1"
set_global_assignment -name VERILOG_FILE ../MatshitaPico_top.v
set_global_assignment -name VERILOG_FILE ../host_if.v
set_global_assignment -name VERILOG_FILE ../clkgen.v
set_global_assignment -name OPTIMIZE_HOLD_TIMING OFF
set_global_assignment -name OPTIMIZE_MULTI_CORNER_TIMING OFF
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
set_global_assignment -name MAX7000_DEVICE_IO_STANDARD TTL
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_location_assignment PIN_87 -to c16m_osc
set_location_assignment PIN_12 -to cn9_reset
set_location_assignment PIN_64 -to cn9_db[0]
set_location_assignment PIN_65 -to cn9_db[1]
set_location_assignment PIN_68 -to cn9_db[2]
set_location_assignment PIN_69 -to cn9_db[3]
set_location_assignment PIN_70 -to cn9_db[4]
set_location_assignment PIN_71 -to cn9_db[5]
set_location_assignment PIN_63 -to cn9_db[6]
set_location_assignment PIN_77 -to cn9_db[7]
set_location_assignment PIN_1 -to cn9_c16m
set_location_assignment PIN_98 -to cn9_data
set_location_assignment PIN_96 -to cn9_dsck
set_location_assignment PIN_99 -to cn9_lrck
set_location_assignment PIN_6 -to cn9_empasis
set_location_assignment PIN_13 -to cn9_effk
set_location_assignment PIN_50 -to rp_d[0]
set_location_assignment PIN_48 -to rp_d[1]
set_location_assignment PIN_47 -to rp_d[2]
set_location_assignment PIN_46 -to rp_d[3]
set_location_assignment PIN_45 -to rp_d[4]
set_location_assignment PIN_42 -to rp_d[5]
set_location_assignment PIN_41 -to rp_d[6]
set_location_assignment PIN_40 -to rp_d[7]
set_location_assignment PIN_62 -to TCK
set_location_assignment PIN_4 -to TDI
set_location_assignment PIN_73 -to TDO
set_location_assignment PIN_15 -to TMS
set_location_assignment PIN_30 -to rp_frame_sync
set_location_assignment PIN_31 -to rp_lrck
set_location_assignment PIN_32 -to rp_bclk
set_location_assignment PIN_22 -to rp_empasis
set_location_assignment PIN_23 -to rp_subq
set_location_assignment PIN_24 -to rp_audio_data
set_location_assignment PIN_27 -to rp_stch_req
set_location_assignment PIN_29 -to rp_dat_avail
set_location_assignment PIN_53 -to rp_st_avail
set_location_assignment PIN_54 -to rp_byte_vld
set_location_assignment PIN_35 -to rp_chan
set_location_assignment PIN_56 -to rp_byte_req
set_location_assignment PIN_37 -to rp_cmd_stb
set_location_assignment PIN_8 -to cn9_scor
set_location_assignment PIN_7 -to cn9_sbcp
set_location_assignment PIN_9 -to cn9_scck
set_location_assignment PIN_83 -to cn9_drq
set_location_assignment PIN_81 -to cn9_dten
set_location_assignment PIN_92 -to cn9_enable
set_location_assignment PIN_76 -to cn9_n_cmd
set_location_assignment PIN_79 -to cn9_n_hrd
set_location_assignment PIN_84 -to cn9_n_hwr
set_location_assignment PIN_93 -to cn9_n_ihac
set_location_assignment PIN_94 -to cn9_n_stch
set_location_assignment PIN_78 -to cn9_n_sten
set_location_assignment PIN_100 -to cn9_n_xaen
set_location_assignment PIN_60 -to cn9_db_dir
set_location_assignment PIN_16 -to cn26_sck
set_location_assignment PIN_17 -to cn26_sdata
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
